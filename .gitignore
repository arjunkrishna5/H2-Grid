# Virtual Environment
.venv/
env/
venv/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data files (keep raw & processed large CSVs/Parquet out of Git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Jupyter Notebooks
.ipynb_checkpoints

# Environment variables & secrets
.env
.env.local

# IDE & Editor settings
.vscode/
.idea/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# SQLite databases
*.db
*.sqlite3

# PDF documents & dossiers (keep local only)
*.pdf
docs/*.pdf
